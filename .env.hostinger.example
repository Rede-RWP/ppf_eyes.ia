# ===== Variáveis para Hostinger Docker Manager =====
# No painel: após implantar, edite Environment / .env da stack.
# Ou crie um arquivo .env na pasta do projeto na VPS (não versionar).

# Obrigatório trocar em produção:
APP_SECRET_KEY=gere-uma-chave-longa-aleatoria-aqui
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
MYSQL_PASSWORD=troque-senha-mysql
MYSQL_ROOT_PASSWORD=troque-senha-root-mysql

# URL pública da VPS (IP ou domínio) — sem barra no final
# Porta 8080: a 80 da Hostinger costuma já estar ocupada
# Ex.: http://2.24.91.218:8080
CORS_ORIGINS=http://2.24.91.218:8080

# Porta HTTP publicada (padrão 8080 no docker-compose)
WEB_PORT=8080

# Cookie seguro só com HTTPS
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# IA
DEFAULT_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

MYSQL_USER=ppf_eyes
MYSQL_DATABASE=ppf_eyes
SNAPSHOT_RETENTION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=480
