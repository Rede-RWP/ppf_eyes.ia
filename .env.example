# App — gere chaves fortes (não use os valores de exemplo em produção)
APP_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ENCRYPTION_KEY=

# CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional defaults (also configurable in UI)
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Paths (relative to ppf-eyes/ root)
DATA_DIR=data

# MySQL / MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ppf_eyes
MYSQL_PASSWORD=change-me-db-password
MYSQL_DATABASE=ppf_eyes
# Ou URL completa (tem prioridade se preenchida):
# DATABASE_URL=mysql+pymysql://ppf_eyes:SENHA@127.0.0.1:3306/ppf_eyes?charset=utf8mb4

# Auth / sessão
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=ppf_eyes_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX=10

# Imagens de alertas não favoritados: apagar após N horas
SNAPSHOT_RETENTION_HOURS=24
