# ===== Produção (VPS Hostinger) =====
# Gere senhas fortes antes de subir.

APP_SECRET_KEY=troque-por-chave-longa-aleatoria
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-senha-forte
ENCRYPTION_KEY=

# Domínio ou IP público da VPS (sem porta se usar 80)
# Ex.: https://eyes.seudominio.com  ou  http://SEU_IP
CORS_ORIGINS=http://SEU_IP_OU_DOMINIO

DEFAULT_AI_PROVIDER=claude
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

DATA_DIR=/app/data

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=ppf_eyes
MYSQL_PASSWORD=troque-senha-mysql
MYSQL_DATABASE=ppf_eyes
MYSQL_ROOT_PASSWORD=troque-senha-root-mysql

ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=ppf_eyes_session
# true se usar HTTPS (recomendado)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX=10

# Imagens de alertas não favoritados: apagar após N horas
SNAPSHOT_RETENTION_HOURS=24
